#!/usr/bin/env bash
# post-merge — STUB hook: refresh the project memory after a merge to main.
#
# The reconcile trigger is "merge onto the canonical branch", not every commit
# (see .memory decision: reconcile-al-merge). Install with:
#
#     ln -sf ../../hooks/post-merge .git/hooks/post-merge
#     chmod +x .git/hooks/post-merge
#
# git fires post-merge after `git merge` / `git pull` completes. We only act on
# the canonical branch; on feature branches the memory is left untouched.
set -euo pipefail

CANONICAL_BRANCH="${MEM_CANONICAL_BRANCH:-main}"
REPO_ROOT="$(git rev-parse --show-toplevel)"
CORE="$REPO_ROOT/core"
MEMORY="$REPO_ROOT/.memory"

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" != "$CANONICAL_BRANCH" ]; then
  echo "[mem] on '$branch' (not '$CANONICAL_BRANCH') — skipping reconcile."
  exit 0
fi

if [ ! -d "$MEMORY" ]; then
  echo "[mem] no .memory/ in this repo — skipping."
  exit 0
fi

echo "[mem] Phase 1: detecting changed curated sources (zero tokens)..."
# ORIG_HEAD is the pre-merge commit; diff against it to scope to this merge.
python3 "$CORE/mem.py" detect --memory "$MEMORY" --since ORIG_HEAD

# --- Phase 2 + commit -------------------------------------------------------
# The LLM call (reconcile) is wired via `claude -p` (uses your subscription, no
# API key). It is OPT-IN here because it edits files and spends tokens on merge.
# Set MEM_AUTORECONCILE=1 to enable. NOTE: the hook must run from a real shell,
# not nested inside a Claude Code session (`claude -p` won't nest).
if [ "${MEM_AUTORECONCILE:-0}" = "1" ]; then
  echo "[mem] Phase 2: reconciling (claude -p)..."
  python3 "$CORE/mem.py" ingest    --memory "$MEMORY" --since ORIG_HEAD --backend llm
  python3 "$CORE/mem.py" reconcile --memory "$MEMORY" --since ORIG_HEAD --apply
  python3 "$CORE/mem.py" index     --memory "$MEMORY"
  python3 "$CORE/mem.py" lint      --memory "$MEMORY" || {
    echo "[mem] lint failed — review before committing the memory."; exit 1; }
  python3 "$CORE/mem.py" detect    --memory "$MEMORY" --update-snapshot
  git add "$MEMORY/wiki" "$MEMORY/index.md" "$MEMORY/log.md"
  git commit -m "memory: reconcile after merge" || true
else
  echo "[mem] Phase 2 disabled (set MEM_AUTORECONCILE=1 to auto-reconcile on merge)."
fi
