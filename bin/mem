#!/usr/bin/env bash
# Thin wrapper so `mem ...` works from anywhere once this dir (or a symlink to
# this file) is on PATH. Auto-discovers the .memory/ upward from the cwd.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")" && pwd)"
exec python3 "$HERE/../core/mem.py" "$@"
